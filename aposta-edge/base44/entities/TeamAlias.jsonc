{
  "name": "TeamAlias",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string"
    },
    "alias": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "normalised_name": {
      "type": "string"
    },
    "is_manual": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "team_id",
    "alias"
  ],
  "rls": {
    "read": {},
