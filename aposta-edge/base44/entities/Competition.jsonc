{
  "name": "Competition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "sport": {
      "type": "string",
      "default": "football"
    },
    "season": {
      "type": "string"
    },
    "external_ids": {
      "type": "object"
    },
    "league_strength": {
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}