{
  "name": "StandingSnapshot",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "position": {
      "type": "number"
    },
    "played": {
      "type": "number"
    },
    "points": {
      "type": "number"
    },
    "goal_difference": {
      "type": "number"
    },
    "source": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "team_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}