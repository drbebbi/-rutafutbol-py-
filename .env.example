# Cedula PY - environment variable NAMES ONLY.
# Never commit real values. Every entry below is a placeholder.

# ---------------------------------------------------------------------------
# Public (shipped to the browser bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable-anon-key>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Server-only (must never be prefixed with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_DB_URL="postgresql://<user>:<password>@<host>:6543/postgres"

# ---------------------------------------------------------------------------
# Deployment / runtime classification
# ---------------------------------------------------------------------------
# LOCAL | PREVIEW | PRODUCTION
CEDULA_ENVIRONMENT="LOCAL"

# Comma separated absolute origins allowed as post-authentication redirects.
CEDULA_AUTH_REDIRECT_ALLOWLIST="http://localhost:3000"

# ---------------------------------------------------------------------------
# Local integration / persistence tests only (never a production database)
# ---------------------------------------------------------------------------
CEDULA_TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:54322/postgres"
