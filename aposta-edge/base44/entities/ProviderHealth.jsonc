{
  "name": "ProviderHealth",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "offline",
        "unconfigured"
      ],
      "default": "unconfigured"
    },
    "last_check_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_success_at": {
      "type": "string",
      "format": "date-time"
    },
    "latency_ms": {
      "type": "number"
    },
    "error_message": {
      "type": "string"
    },
    "config": {
      "type": "object"
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}