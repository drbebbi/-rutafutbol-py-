{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "short_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "sport": {
      "type": "string",
      "default": "football"
    },
    "elo_rating": {
      "type": "number",
      "default": 1500
    },
    "elo_rating_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_ids": {
      "type": "object"
    },
    "logo_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "elo_games": {
      "type": "number",
      "default": 0,
      "description": "Results the Elo rating was fitted on; Elo is ignored below the minimum"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
