{
  "name": "cedula-py",
  "version": "0.1.0",
  "private": true,
  "description": "Cedula PY - technical foundation (Phase 3). Mobile-first PWA helping foreigners understand and organise their first Paraguayan cedula.",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run typecheck && npm run lint && npm run check:boundaries && npm run validate:rules && npm run validate:sources && npm run verify:bundle && vitest run --project unit --project rules --project engine --project golden --project property --project architecture --project security --project application",
    "test:unit": "vitest run --project unit",
    "test:rules": "vitest run --project rules",
    "test:engine": "vitest run --project engine",
    "test:golden": "vitest run --project golden",
    "test:property": "vitest run --project property",
    "test:architecture": "vitest run --project architecture",
    "test:security": "vitest run --project security",
    "test:application": "vitest run --project application",
    "test:integration": "vitest run --project integration",
    "test:persistence": "vitest run --project persistence",
    "test:db": "tsx scripts/run-pgtap.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project unit --project rules --project engine --project golden --project property --coverage",
    "validate:rules": "tsx scripts/validate-rules.ts",
    "validate:sources": "tsx scripts/validate-sources.ts",
    "verify:bundle": "tsx scripts/verify-evaluation-bundle.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:types": "supabase gen types typescript --local --schema app,core,research,audit,security > src/infrastructure/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "fast-check": "4.9.0",
    "pg": "8.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
